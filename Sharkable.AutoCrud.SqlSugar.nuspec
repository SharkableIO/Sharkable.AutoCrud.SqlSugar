<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>Sharkable.AutoCrud.SqlSugar</id>
    <version>0.5.5</version>
    <title>Sharkable.AutoCrud.SqlSugar</title>
    <authors>charleypeng</authors>
    <readme>docs\README.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <icon>sharkable.jpg</icon>
    <projectUrl>https://github.com/SharkableIO/Sharkable.AutoCrud.SqlSugar</projectUrl>
    <description>AutoCrud SqlSugar plugin for Sharkable — automatic CRUD API generation with health check</description>
    <releaseNotes>BREAKING (SHARK-SEC-006): add [CrudAllow] field allowlist on AutoCrud insert/update; endpoints with Create|Update enabled and zero [CrudAllow] properties throw InvalidOperationException at startup. BREAKING (SHARK-SEC-006 follow-up): exclude SafeSoftDeleteField from [CrudAllow] allow-list even when explicitly marked (honors [SugarColumn(ColumnName=...)] renames). BREAKING (SHARK-SEC-006 follow-up): POST and PUT now return the persisted row re-read from DB instead of the user-controlled request body.</releaseNotes>
    <copyright>CopyRight 2026 Penglei</copyright>
    <tags>sharkable autocrud sqlsugar orm minimalapi</tags>
    <dependencies>
      <dependency id="Sharkable" version="0.5.5" />
      <dependency id="SqlSugarCore" version="5.1.4.215" />
    </dependencies>
  </metadata>
   <files>
    <file src="README.md" target="docs\" />
    <file src="sharkable.jpg" target="\" />
  </files>
</package>